{
  "info": {
    "name": "Caregiver Management Service (All-in-One)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3003" },
    { "key": "user_id", "value": "10" },
    { "key": "user_role", "value": "CAREGIVER" },
    { "key": "admin_id", "value": "1" },
    { "key": "admin_role", "value": "ADMIN" },
    { "key": "profile_id", "value": "1" },
    { "key": "document_id", "value": "1" },
    { "key": "service_link_id", "value": "1" },
    { "key": "area_id", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "1. Create Profile (CAREGIVER)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.id) { pm.collectionVariables.set('profile_id', String(res.data.id)); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "x-user-role", "value": "{{user_role}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"introduction\": \"Điều dưỡng viên có kinh nghiệm chăm sóc người cao tuổi\",\n  \"qualification\": \"Cử nhân Điều dưỡng\",\n  \"experience_years\": 3,\n  \"license_number\": \"CCHN-2026-001\"\n}"
        },
        "url": "{{base_url}}/api/caregivers/profiles"
      }
    },
    {
      "name": "2. Get My Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "x-user-role", "value": "{{user_role}}" }
        ],
        "url": "{{base_url}}/api/caregivers/profiles/me"
      }
    },
    {
      "name": "3. Verify Profile - APPROVED (ADMIN)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{admin_id}}" },
          { "key": "x-user-role", "value": "{{admin_role}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verification_status\": \"APPROVED\",\n  \"rejection_reason\": null\n}"
        },
        "url": "{{base_url}}/api/caregivers/profiles/{{profile_id}}/verify"
      }
    },
    {
      "name": "4. Add Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.id) { pm.collectionVariables.set('document_id', String(res.data.id)); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "x-user-role", "value": "{{user_role}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_type\": \"CERTIFICATE\",\n  \"document_name\": \"Chứng chỉ hành nghề điều dưỡng\",\n  \"document_url\": \"https://example.com/docs/chung-chi.pdf\"\n}"
        },
        "url": "{{base_url}}/api/caregivers/profiles/{{profile_id}}/documents"
      }
    },
    {
      "name": "5. Add Care Service",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "x-user-role", "value": "{{user_role}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"care_service_id\": 1,\n  \"custom_price\": 120000\n}"
        },
        "url": "{{base_url}}/api/caregivers/profiles/{{profile_id}}/services"
      }
    },
    {
      "name": "6. Add Service Area",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "x-user-role", "value": "{{user_role}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"province\": \"Gia Lai\",\n  \"district\": \"Quy Nhơn\"\n}"
        },
        "url": "{{base_url}}/api/caregivers/profiles/{{profile_id}}/areas"
      }
    }
  ]
}